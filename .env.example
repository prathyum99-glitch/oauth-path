# Required for live generation (server-side only, never commit a real value)
ANTHROPIC_API_KEY=

# Optional
ANTHROPIC_MODEL=claude-sonnet-5-5
# Looks up whether Composio provides a managed OAuth app for the app being researched
COMPOSIO_API_KEY=
# Persistent share links for live-generated guides (Upstash Redis via the Vercel Marketplace sets these)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Live generations allowed per IP per hour (default 6)
GENERATION_LIMIT_PER_HOUR=6
